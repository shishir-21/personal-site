# Supabase — powers the visitor counter.
# Copy this file to .env.local and fill in values from your Supabase project:
#   Project Settings → Data API  → Project URL
#   Project Settings → API Keys  → service_role (secret) key
# The service_role key is server-only (used by /api/visitors) and must never be
# exposed to the browser. Without these, the visitor counter silently does nothing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
